{
  "name": "ruin-game",
  "version": "1.0.0",
  "description": "Ruin - A dungeon exploration game built with PixiJS",
  "main": "src/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "serve": "vite preview",
    "lint": "eslint src --ext .js,.ts,.jsx,.tsx",
    "lint:fix": "eslint src --ext .js,.ts,.jsx,.tsx --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "keywords": [
    "game",
    "pixijs",
    "dungeon",
    "exploration",
    "javascript",
    "roguelike"
  ],
  "author": "Anh Tuan",
  "license": "MIT",
  "dependencies": {
    "@pixi/sound": "^6.0.1",
    "pixi.js": "^8.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.0.0",
    "@types/pixi.js": "^5.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/ui": "^4.0.7",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^4.0.7"
  },
  "engines": {
    "node": ">=20.14.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/ruin-game.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/ruin-game/issues"
  },
  "homepage": "https://github.com/yourusername/ruin-game#readme"
}
